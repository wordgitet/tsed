    },
    {
      "id": "address.mark",
      "section": "Addresses in ed",
      "summary": "Resolve lowercase marked lines.",
      "disposition": "covered",
      "coverage": [
        "address/mark-follows-moved-line",
        "torture/mark/reassign-mark",
        "torture/mark/deleted-mark-errors"
      ]
    },
    {
      "id": "address.search",
      "section": "Addresses in ed",
      "summary": "Search forward and backward with wraparound and null BRE reuse.",
      "disposition": "covered",
      "coverage": [
        "issue8/delimiter/omitted-forward-search",
        "issue8/delimiter/omitted-backward-search",
        "torture/locale/literal-search"
      ]
    },
