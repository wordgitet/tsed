{
  "format": "tsed-posix-requirements",
  "version": 1,
  "standard": "POSIX.1-2024",
  "source": "https://pubs.opengroup.org/onlinepubs/9799919799.2024edition/utilities/ed.html",
  "requirements": [
    {
      "id": "option.syntax",
      "section": "OPTIONS",
      "summary": "Parse the specified option forms.",
      "disposition": "covered",
      "coverage": [
        "process/rejects-unknown-option",
        "torture/options/combined-silent-prompt",
        "torture/options/attached-prompt",
        "torture/options/end-options-before-hyphen-file"
      ]
    },
    {
      "id": "option.prompt",
      "section": "OPTIONS",
      "summary": "Use and toggle the requested prompt.",
      "disposition": "covered",
      "coverage": [
        "output/prompt-string",
        "terminal/prompt-and-quit",
        "torture/terminal/default-prompt-toggle"
      ]
    },
    {
      "id": "option.silent",
      "section": "OPTIONS",
      "summary": "Suppress counts and shell completion.",
      "disposition": "covered",
      "coverage": [
        "output/silent-suppresses-counts",
        "torture/options/silent-write-count",
        "torture/options/silent-shell-completion"
      ]
    },
    {
      "id": "operand.file",
      "section": "OPERANDS",
      "summary": "Load at most one initial file operand.",
      "disposition": "covered",
      "coverage": [
        "file/initial-byte-count",
        "process/rejects-too-many-operands",
        "torture/operand/loads-and-remembers-pathname",
        "torture/operand/empty-file-has-line-zero"
      ]
    },
    {
      "id": "environment.locale",
      "section": "ENVIRONMENT VARIABLES",
      "summary": "Apply locale rules to text and BRE processing.",
      "disposition": "platform-dependent",
      "coverage": [
        "torture/locale/environment-lang-selects-ctype",
        "torture/locale/environment-lc-ctype-overrides-lang",
        "torture/locale/environment-lc-all-overrides-ctype"
      ]
    },
    {
      "id": "signal.int",
      "section": "ASYNCHRONOUS EVENTS",
      "summary": "Interrupt input and return to command mode.",
      "disposition": "covered",
      "coverage": [
        "terminal/sigint-interrupts-input",
        "torture/terminal/sigint-in-command-mode",
        "torture/terminal/repeated-sigint"
      ]
    },
    {
      "id": "signal.quit",
      "section": "ASYNCHRONOUS EVENTS",
      "summary": "Ignore SIGQUIT.",
      "disposition": "covered",
      "coverage": [
        "terminal/sigquit-is-ignored",
        "torture/terminal/sigquit-command-mode",
        "torture/terminal/sigquit-input-mode"
      ]
    },
    {
      "id": "signal.hup",
      "section": "ASYNCHRONOUS EVENTS",
      "summary": "Save changed text on SIGHUP.",
      "disposition": "covered",
      "coverage": [
        "terminal/sighup-saves-buffer",
        "terminal/sighup-falls-back-to-home",
        "torture/terminal/sighup-unchanged-buffer-does-not-save",
        "torture/terminal/sighup-after-full-write-does-not-save"
      ]
    },
    {
      "id": "input.text",
      "section": "STDIN",
      "summary": "Read command and input text as lines.",
      "disposition": "covered",
      "coverage": [
        "input/command-looking-lines-are-text",
        "torture/input/empty-lines-are-text",
        "torture/input/backslash-period-is-literal",
        "torture/input/long-line"
      ]
    },
    {
      "id": "buffer.change-state",
      "section": "EXTENDED DESCRIPTION",
      "summary": "Maintain unchanged, changed, and warned buffer states.",
      "disposition": "covered",
      "coverage": [
        "issue8/change-state/warning-survives-print",
        "issue8/change-state/new-change-rearms-warning",
        "terminal/modified-warning"
      ]
    },
    {
      "id": "regex.bre",
      "section": "Regular Expressions in ed",
      "summary": "Use POSIX BRE matching.",
      "disposition": "covered",
      "coverage": [
        "regex/delimiter-in-bracket-expression",
        "regex/escaped-address-delimiter",
        "regex/null-expression-in-substitute",
        "torture/regex/bracket-delimiter-21",
        "torture/regex/bracket-delimiter-23",
        "torture/regex/bracket-delimiter-25",
        "torture/regex/bracket-delimiter-2b",
        "torture/regex/bracket-delimiter-2d",
        "torture/regex/bracket-delimiter-2f",
        "torture/regex/bracket-delimiter-3a",
        "torture/regex/bracket-delimiter-3d",
        "torture/regex/bracket-delimiter-3f",
        "torture/regex/bracket-delimiter-40"
      ]
    },
    {
      "id": "regex.locale",
      "section": "Regular Expressions in ed",
      "summary": "Use locale classes, collation, and multibyte characters.",
      "disposition": "platform-dependent",
      "coverage": [
        "torture/locale/dot-is-one-character",
        "torture/locale/two-dots-are-two-characters",
        "torture/locale/backreferences-preserve-characters",
        "torture/locale/global-literal"
      ]
    },
    {
      "id": "address.basic",
      "section": "Addresses in ed",
      "summary": "Resolve current, last, numeric, and offset addresses.",
      "disposition": "covered",
      "coverage": [
        "address/intermediate-out-of-range",
        "torture/address/offset/target-1-form-1",
