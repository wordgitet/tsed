{
  "name": "@wordgitet/tsed",
  "version": "0.1.0-alpha.1",
  "description": "A POSIX-oriented ed line editor implemented in TypeScript for Bun",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/wordgitet/tsed.git"
  },
  "bugs": {
    "url": "https://codeberg.org/wordgitet/tsed/issues"
  },
  "homepage": "https://codeberg.org/wordgitet/tsed",
  "keywords": [
    "ed",
    "editor",
    "posix",
    "bun",
    "typescript"
  ],
  "type": "module",
  "files": [
    "bin",
    "src",
    "README",
    "TOUR",
    "COPYRIGHT"
  ],
  "bin": {
    "tsed": "bin/tsed",
    "ed": "bin/tsed"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "test:tour": "bun test test/tour.test.ts",
    "typecheck": "tsc --noEmit",
    "check:style": "bun src/style_check.ts",
    "check": "bun run typecheck && bun run build && bun test && bun run check:style",
    "build": "bun src/build.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
