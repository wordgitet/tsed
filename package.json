{
  "name": "@wordgitet/tsed",
  "version": "0.2.0-alpha.1",
  "description": "A POSIX-oriented ed line editor implemented in TypeScript for Bun",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/wordgitet/tsed.git"
  },
  "bugs": {
    "url": "https://codeberg.org/wordgitet/tsed/issues"
  },
  "homepage": "https://codeberg.org/wordgitet/tsed",
  "keywords": [
    "ed",
    "editor",
    "posix",
    "bun",
    "typescript"
  ],
  "type": "module",
  "files": [
    "bin",
    "binding.gyp",
    "native",
    "prebuilds",
    "src",
    "test/portable",
    "README",
    "TOUR",
    "COPYRIGHT"
  ],
  "bin": {
    "tsed": "bin/tsed",
    "ed": "bin/tsed"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:native": "CC=${CC:-cc} CXX=${CXX:-c++} node-gyp rebuild",
    "install": "CC=cc CXX=cc node-gyp-build",
    "make:prebuilds": "CC=${CC:-cc} CXX=${CXX:-c++} prebuildify --napi --strip --tag-libc",
    "test": "bun test",
    "generate:portable": "bun tools/generate_portable_corpus.ts",
    "test:portable": "bun test/portable_runner.ts",
    "test:integration": "bun test --path-ignore-patterns='__never__' test/integration --timeout=10000",
    "test:fuzz": "bun tools/fuzz_model.ts",
    "test:fuzz:ed": "bun tools/fuzz_differential.ts",
    "test:fuzz:all": "bun run test:fuzz && bun run test:fuzz:ed",
    "test:all": "bun run check && bun run test:portable && bun run test:integration && bun run test:fuzz:all",
    "probe:bun-sigbus": "bun tools/probe_bun_signal.ts",
    "test:tour": "bun test test/tour.test.ts",
    "typecheck": "tsc --noEmit",
    "check:style": "bun src/style_check.ts",
    "check": "bun run typecheck && bun run build && bun run test && bun run check:style",
    "build": "bun run build:native && bun src/build.ts"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "node-gyp": "^13.0.1",
    "prebuildify": "^6.0.1",
    "typescript": "latest"
  }
}
